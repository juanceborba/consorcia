// prisma/schema.prisma — ConsorcIA
// Spec canónica: vault/02_Arquitectura y Stack/PRD-02-04 Base de Datos.md (§2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// EXTENSIONES
// ==========================================
// pgvector se habilita vía migration SQL, no en Prisma schema

// ==========================================
// ENUMS
// ==========================================

enum RolUsuario {
  SUPERADMIN  // Staff ConsorcIA
  ORG_ADMIN   // Dueño de la organización: facturación, alta de edificios/usuarios
  GESTOR      // Staff de la organización que opera edificios asignados
  CONSEJO     // Scope edificio
  PROPIETARIO // Scope edificio/UF
  INQUILINO   // Scope edificio/UF
  ENCARGADO   // Scope edificio
  PROVEEDOR   // Scope edificio
}

// Tipo de invitación (S4-02, PRD-04-11 §2.3): define qué vínculos crea al
// aceptarse (STAFF → membresía + edificios de gestor · RESIDENTE → UnidadUsuario)
enum TipoInvitacion {
  STAFF
  RESIDENTE
}

enum EstadoUnidad {
  ACTIVA
  INACTIVA
  EN_VENTA
  ALQUILADA
}

enum CategoriaGasto {
  A // Gastos generales → todas las UF
  B // Servicios específicos → solo UF que los usan
  C // Sectores específicos → solo UF del sector
}

// Base de cálculo de un esquema de reparto (S3-20). Es un enum CERRADO a
// propósito: el reparto tiene que seguir siendo determinístico y auditable, así
// que no hay fórmulas ni condiciones configurables — solo estas tres bases y una
// tabla de pesos por UF (ver `EsquemaReparto`).
enum BaseReparto {
  COEFICIENTE    // peso = coeficiente de la UF × el factor de la tabla (default 1)
  PARTES_IGUALES // peso = 1 × el factor de la tabla: por UF, no por coeficiente
  PESOS_PROPIOS  // peso = el de la tabla: la segunda tabla de coeficientes del reglamento
}

// A qué UF alcanza un esquema de reparto (S3-20). Fuera del alcance el peso es
// SIEMPRE 0, cualquiera sea la base.
enum AlcanceReparto {
  TODAS     // todas las UF del edificio
  SERVICIO  // las que tienen el servicio de `alcanceValor` en `Unidad.categoriaB`
  SECTOR    // las del sector de `alcanceValor` en `Unidad.categoriaC`
  SELECCION // solo las que tienen fila propia en `EsquemaRepartoUnidad`
}

enum EstadoLiquidacion {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  ENVIADA
  COBRADA
  ANULADA
}

enum EstadoCobro {
  PENDIENTE
  PAGADO
  PARCIAL
  MOROSO
  PERDONADO
}

enum EstadoTicket {
  NUEVO
  ASIGNADO
  EN_PROGRESO
  ESPERA_PROPIETARIO
  RESUELTO
  CERRADO
  REABIERTO
}

enum PrioridadTicket {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum TipoComunicacion {
  EMAIL
  WHATSAPP
  NOTIFICACION_PUSH
  SMS
}

enum TipoDocumento {
  RECIBO_EXPENSA
  FACTURA
  COMPROBANTE_PAGO
  ACTA_ASAMBLEA
  CONTRATO
  SEGURO
  OTRO
}

// ==========================================
// ORGANIZACIONES (TENANT RAÍZ)
// ==========================================

model Organizacion {
  id              String   @id @default(uuid())

  // Identificación
  nombre          String
  cuit            String   @unique // CUIT de la administración/estudio
  plan            String   @default("starter") // Plan de suscripción SaaS

  // Ley 941 CABA: la matrícula es del administrador responsable, no del edificio
  matriculaRPA    String   @map("matricula_rpa")

  // Relaciones
  edificios       Edificio[]
  miembros        OrganizacionUsuario[]
  invitaciones    Invitacion[]
  config          OrganizacionConfig?
  proveedores     Proveedor[] // propios de la org (los globales tienen organizacionId null)
  rubros          Rubro[]     // ítems propios de la org (el maestro tiene organizacionId null)

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("organizaciones")
}

// Membresía: usuario ↔ organización (staff: org_admin, gestor)
model OrganizacionUsuario {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  usuarioId       String   @map("usuario_id")

  // Rol de organización: ORG_ADMIN o GESTOR
  rol             RolUsuario

  // Baja lógica de la membresía (S4-01): el Usuario global sobrevive, pierde
  // el acceso a esta organización. Nunca se borra la fila (auditoría).
  activo          Boolean  @default(true)

  // Relaciones
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id])
  usuario         Usuario      @relation(fields: [usuarioId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([organizacionId, usuarioId])
  @@index([usuarioId])
  @@index([usuarioId, activo])
  @@map("organizacion_usuarios")
}

// Edificios asignados a cada gestor
model GestorEdificio {
  id              String   @id @default(uuid())
  usuarioId       String   @map("usuario_id")
  edificioId      String   @map("edificio_id")

  // Relaciones
  gestor          Usuario  @relation(fields: [usuarioId], references: [id])
  edificio        Edificio @relation(fields: [edificioId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([usuarioId, edificioId])
  @@index([edificioId])
  @@map("gestor_edificios")
}

// ==========================================
// USUARIOS Y AUTENTICACIÓN
// ==========================================

// Identidad GLOBAL (S4-01, PRD-04-11 §2): un Usuario existe una sola vez en el
// sistema y se identifica por su email (normalizado lowercase). Es la excepción
// documentada al "todo cuelga de la organización": el Usuario no tiene tenant,
// los permisos son vínculos (OrganizacionUsuario / GestorEdificio / UnidadUsuario).
model Usuario {
  id              String   @id @default(uuid())
  email           String   @unique
  // Null mientras la cuenta no fue activada: el alta por backoffice (S4-03/04)
  // crea al Usuario sin password y la define él al aceptar la invitación
  // (S4-02). Sin password no hay login posible.
  passwordHash    String?  @map("password_hash")
  nombre          String
  apellido        String
  telefono        String?
  activo          Boolean  @default(true)

  // Relaciones
  organizaciones  OrganizacionUsuario[]
  edificiosGestionados GestorEdificio[]
  unidades        UnidadUsuario[]
  ticketsCreados  Ticket[]         @relation("TicketCreador")
  ticketsAsignados Ticket[]        @relation("TicketAsignado")
  auditLogs       AuditLog[]
  invitacionesEnviadas Invitacion[] @relation("InvitacionAutor")

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([activo])
  @@map("usuarios")
}

// Invitación de activación (S4-02, PRD-04-11 §2.3). La crea el backoffice
// (S4-03 staff / S4-04 residentes) y la consume el invitado en
// `/invitacion/:token`: define su password y los vínculos del `payload` se
// materializan. Un solo uso (`usadaAt`) y vence a los 7 días.
model Invitacion {
  id              String   @id @default(uuid())
  email           String   // Normalizado lowercase (identidad global)
  organizacionId  String   @map("organizacion_id")
  tipo            TipoInvitacion

  // STAFF:     { rol, nombre?, apellido?, edificioIds[] }
  // RESIDENTE: { nombre?, apellido?, unidadId, esPropietario, esInquilino, fechaInicio? }
  payload         Json

  token           String   @unique @default(uuid()) // va en el link /invitacion/:token
  expiraAt        DateTime @map("expira_at")
  usadaAt         DateTime? @map("usada_at")
  invitadoPorId   String   @map("invitado_por_id") // auditoría: quién invitó

  // S4-11 (SEC-02): true si el alta que generó esta invitación fue la que CREÓ
  // la identidad global. Solo esa invitación puede definir la password de un
  // `Usuario` que todavía no está activado — si no, un org_admin de otra
  // organización podría fijarle la credencial a una persona que un tenant
  // ajeno aprovisionó. En el reenvío se conserva (el link rota, el origen no).
  creaUsuario     Boolean  @default(false) @map("crea_usuario")

  // Relaciones
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id])
  invitadoPor     Usuario      @relation("InvitacionAutor", fields: [invitadoPorId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Una sola invitación PENDIENTE por (email, organización, tipo): se aplica
  // con un índice único parcial `WHERE usada_at IS NULL` creado en la
  // migración (Prisma no expresa índices parciales). Reenviar = regenerar
  // token/expiración de la misma fila.
  @@index([organizacionId, email])
  @@index([organizacionId, tipo])
  @@map("invitaciones")
}

// ==========================================
// EDIFICIOS Y UNIDADES
// ==========================================

model Edificio {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  nombre          String
  direccion       String
  ciudad          String
  provincia       String
  codigoPostal    String   @map("codigo_postal")

  // Tipología del consorcio: "ph", "barrio_privado", "centro_comercial", "otro" (S2-01)
  tipo            String   @default("ph")

  // Soft delete (S2-01): false = dado de baja; se conserva por Ley 941
  activo          Boolean  @default(true)

  // Propiedad Horizontal
  reglamentoPH    String?  @map("reglamento_ph") // URL al documento
  fechaInicioAdmin DateTime? @map("fecha_inicio_admin")

  // Características
  antiguedad      Int?     // Años
  totalM2         Decimal  @map("total_m2") @db.Decimal(10, 2)
  amenities       String[] // pileta, gimnasio, sum, etc.

  // Relaciones
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id])
  gestores        GestorEdificio[]
  unidades        Unidad[]
  gastos          Gasto[]
  liquidaciones   Liquidacion[]
  esquemasReparto EsquemaReparto[]
  configuracionLiquidacion ConfiguracionLiquidacion?
  reglasFondoReserva ReglaFondoReserva[]
  tickets         Ticket[]
  comunicaciones  Comunicacion[]
  documentos      Documento[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizacionId])
  @@index([organizacionId, ciudad])
  @@index([organizacionId, activo])
  @@map("edificios")
}

model Unidad {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Identificación
  numero          String   // "3A", "PB", "Coch-12", etc.
  tipo            String   // "departamento", "local", "cochera", "baulera", "oficina"

  // Propiedad Horizontal
  m2              Decimal  @db.Decimal(10, 2)
  coeficiente     Decimal  @db.Decimal(10, 6) // 0.076543 = 7.6543%

  // Categorías de distribución
  categoriaA      Boolean  @default(true) @map("categoria_a") // Gastos generales
  categoriaB      String[] @map("categoria_b") // Servicios específicos: ["ascensor", "calefaccion"]
  categoriaC      String?  @map("categoria_c") // Sector específico: "torre_a", "pileta"

  // Estado
  estado          EstadoUnidad @default(ACTIVA)

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])
  usuarios        UnidadUsuario[]
  liquidaciones   LiquidacionDetalle[]
  pesosReparto    EsquemaRepartoUnidad[]
  cobros          Cobro[]
  recibos         Recibo[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([organizacionId, edificioId, numero])
  @@index([organizacionId, edificioId])
  @@index([organizacionId, edificioId, tipo])
  @@map("unidades")
}

model UnidadUsuario {
  id          String   @id @default(uuid())
  organizacionId    String   @map("organizacion_id")
  unidadId    String   @map("unidad_id")
  usuarioId   String   @map("usuario_id")

  // Rol específico en esta unidad
  esPropietario Boolean @default(false) @map("es_propietario")
  esInquilino   Boolean @default(false) @map("es_inquilino")
  fechaInicio   DateTime @map("fecha_inicio")
  fechaFin      DateTime? @map("fecha_fin")

  // Relaciones
  unidad      Unidad   @relation(fields: [unidadId], references: [id])
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([organizacionId, unidadId, usuarioId])
  @@index([organizacionId, usuarioId])
  @@map("unidad_usuarios")
}

// ==========================================
// GASTOS
// ==========================================

// Directorio híbrido de proveedores (PRD-04-02 §1.3): organizacionId null =
// global de plataforma (lo ven todas las orgs); set = propio de la org.
// La org ve globales + propios activos. Ningún gasto se carga sin proveedor.
model Proveedor {
  id              String   @id @default(uuid())
  organizacionId  String?  @map("organizacion_id") // null = global plataforma

  razonSocial     String   @map("razon_social")
  // Dedup por org: índice único PARCIAL SQL creado a mano en la migración
  // (Prisma no expresa índices parciales):
  //   CREATE UNIQUE INDEX proveedores_cuit_org_unique
  //     ON proveedores (organizacion_id, cuit) WHERE cuit IS NOT NULL;
  cuit            String?
  email           String?
  telefono        String?
  direccion       String?
  rubroHabitualId String?  @map("rubro_habitual_id") // rubro sugerido al cargar gastos
  notas           String?
  activo          Boolean  @default(true)

  // Relaciones
  organizacion    Organizacion? @relation(fields: [organizacionId], references: [id])
  rubroHabitual   Rubro?        @relation(fields: [rubroHabitualId], references: [id])
  gastos          Gasto[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String?  @map("created_by")

  @@index([organizacionId])
  @@map("proveedores")
}

// Árbol de rubros de 2 niveles fijos (PRD-04-02 §1.4): organizacionId null =
// ítem del maestro plataforma; parentId null = rubro (nivel 1), set = subrubro
// (nivel 2, hoja). Un subrubro propio puede colgar de un rubro maestro visible
// o de un rubro propio. Nunca se borra un ítem con gastos → activo = false.
model Rubro {
  id              String   @id @default(uuid())
  organizacionId  String?  @map("organizacion_id") // null = maestro plataforma
  parentId        String?  @map("parent_id")       // null = rubro; set = subrubro

  nombre          String
  orden           Int      @default(0)
  activo          Boolean  @default(true)

  // Relaciones
  organizacion    Organizacion? @relation(fields: [organizacionId], references: [id])
  parent          Rubro?        @relation("RubroHijos", fields: [parentId], references: [id])
  hijos           Rubro[]       @relation("RubroHijos")
  visibilidad     RubroVisibilidad[]
  gastos          Gasto[]
  proveedoresHabituales Proveedor[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Nombre único entre hermanos. NOTA: en Postgres un UNIQUE con columnas
  // NULLables no restringe las filas con NULL, así que este constraint solo
  // aplica de hecho a los subrubros de una org. La unicidad del maestro y de
  // los rubros nivel 1 se refuerza con índices únicos parciales en la
  // migración (ver 20260729140000_s3_gastos_proveedores_rubros).
  @@unique([organizacionId, parentId, nombre])
  @@index([organizacionId])
  @@map("rubros")
}

// Override de visibilidad por org sobre ítems del maestro (PRD-04-02 §1.4):
// visible = false oculta el ítem para esa org (ocultar un rubro oculta sus
// subrubros). Árbol de la org = maestro visible + ítems propios activos.
model RubroVisibilidad {
  organizacionId  String  @map("organizacion_id")
  rubroId         String  @map("rubro_id")
  visible         Boolean

  // Relaciones
  rubro           Rubro   @relation(fields: [rubroId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([organizacionId, rubroId])
  @@map("rubro_visibilidad")
}

model Gasto {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Proveedor y segmentación (PRD-04-02 §1.1): ambos obligatorios
  proveedorId     String   @map("proveedor_id")
  rubroId         String   @map("rubro_id") // siempre un subrubro/rubro hoja visible para la org

  // Datos del gasto
  concepto        String
  descripcion     String?
  monto           Decimal  @db.Decimal(12, 2)
  moneda          String   @default("ARS")

  // Categorización
  categoria       CategoriaGasto
  servicioEspecifico String? @map("servicio_especifico") // Para cat B: "ascensor"
  sectorEspecifico   String? @map("sector_especifico")   // Para cat C: "torre_a"

  // Esquema de reparto propio del gasto (S3-20): el OVERRIDE. NULL = el gasto
  // adopta lo que el edificio tenga configurado para su categoría/servicio/sector
  // y, si no hay nada, el reparto por coeficiente de siempre. La categoría sigue
  // clasificando el gasto (recibo, dashboard, Ley 941) aunque el esquema decida
  // el cálculo: son los dos trabajos que S3-20 separó.
  esquemaRepartoId String? @map("esquema_reparto_id")

  // Clasificación
  esOrdinario     Boolean  @default(true) @map("es_ordinario") // true = ordinario, false = extraordinario

  // Documento soporte
  comprobanteUrl  String?  @map("comprobante_url")

  // Fechas
  fechaGasto      DateTime @map("fecha_gasto")
  // Período de imputación del gasto. Si el gasto tiene un plan de cuotas
  // (S3-19), `periodo` es el del comprobante y el de la PRIMERA cuota; los
  // períodos que se liquidan salen de `cuotas`, no de acá.
  periodo         String   // "2026-07"

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])
  proveedor       Proveedor @relation(fields: [proveedorId], references: [id])
  rubro           Rubro     @relation(fields: [rubroId], references: [id])
  // Restrict explícito: es lo que hace la FK en la DB (un esquema en uso no se
  // borra, se desactiva). Sin declararlo, Prisma asumiría `SetNull` por ser una
  // relación opcional y `migrate diff` marcaría deriva contra la migración.
  esquemaReparto  EsquemaReparto? @relation(fields: [esquemaRepartoId], references: [id], onDelete: Restrict)
  liquidaciones   LiquidacionDetalle[]
  cuotas          GastoCuota[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by")
  deletedAt       DateTime? @map("deleted_at") // soft delete (Ley 941, PRD-04-02 §6)

  @@index([organizacionId, edificioId])
  @@index([organizacionId, edificioId, periodo])
  @@index([organizacionId, edificioId, categoria])
  @@index([organizacionId, edificioId, esOrdinario])
  @@index([organizacionId, edificioId, proveedorId])
  @@index([organizacionId, edificioId, rubroId])
  @@index([organizacionId, esquemaRepartoId])
  @@map("gastos")
}

// Plan de cuotas de un gasto (S3-19, brecha 1 del research
// `docs/investigacion/ordinarias-extraordinarias-y-categorias.md`): una obra de
// $X en N cuotas se imputa X/N por período en vez de caer entera en uno solo.
//
// El `Gasto` sigue siendo LA FACTURA (su `monto` es el total del comprobante del
// proveedor y reconcilia con él); las cuotas son las IMPUTACIONES por período.
// Un gasto sin filas acá es de imputación única y se comporta como antes de
// S3-19 — ese es el default y no hay que configurar nada para liquidar.
//
// Invariante (test automático, cero tolerancia): Σ`monto` de las cuotas de un
// gasto = `gasto.monto`. El ajuste de centavos de la división va en la ÚLTIMA
// cuota, igual que el motor lo hace en la última UF alcanzada.
model GastoCuota {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  gastoId         String   @map("gasto_id")

  numero          Int      // 1..cuotasTotal
  cuotasTotal     Int      @map("cuotas_total")
  periodo         String   // "2026-08" — el período al que se imputa ESTA cuota
  monto           Decimal  @db.Decimal(12, 2)

  // Relaciones
  gasto           Gasto    @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  liquidaciones   LiquidacionDetalle[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Una cuota k por gasto, y un solo período por gasto: dos cuotas del mismo
  // gasto en el mismo período romperían la unicidad de `LiquidacionDetalle`
  // (organizacion, liquidacion, unidad, gasto).
  @@unique([organizacionId, gastoId, numero])
  @@unique([organizacionId, gastoId, periodo])
  @@index([organizacionId, gastoId])
  @@index([organizacionId, periodo])
  @@map("gasto_cuotas")
}

// ==========================================
// ESQUEMAS DE REPARTO (S3-20)
// ==========================================

// El "setup de liquidación" de un edificio (S3-20, diseño en
// `docs/investigacion/esquemas-de-reparto.md`).
//
// LA PRIMITIVA ES UNA SOLA: pesos por unidad funcional. `monto_i = monto × peso_i
// / Σpesos`. No es un motor de reglas — no hay condiciones ni fórmulas, solo un
// enum cerrado de bases (`BaseReparto`) y una tabla de pesos. Esa restricción es
// lo que mantiene el cálculo determinístico y auditable, y es deliberada.
//
// La fuente de autoridad es el REGLAMENTO DE COPROPIEDAD, no el criterio del
// administrador: el CCyC art. 2049, último párrafo, permite eximir parcialmente
// a las UF sin acceso a un servicio o sector, y lo hace "el reglamento". De ahí
// `clausulaReglamento` y `documentoUrl`: el esquema guarda con qué cláusula se
// habilita, que es lo primero que se discute cuando un propietario impugna.
//
// El peso de la tabla (`EsquemaRepartoUnidad.peso`) se lee SEGÚN LA BASE:
//
//   COEFICIENTE     → FACTOR sobre el coeficiente de la UF. Fila ausente = 1.
//                     0 = exenta total · 0.5 = "PB abona el 50% del ascensor".
//   PARTES_IGUALES  → FACTOR sobre 1. Fila ausente = 1.
//   PESOS_PROPIOS   → el peso ABSOLUTO (el "coeficiente de Torre A" del
//                     reglamento, que NO es proporcional al general). Fila
//                     ausente = 0: sin fila, la UF no participa.
//
// Y el alcance se aplica ANTES que la base: fuera del alcance el peso es 0.
//
// RESOLUCIÓN (una sola función, `resolverEsquema` en services/esquemas-reparto.js):
// esquema del gasto → esquema del edificio que matchea el servicio/sector →
// `ConfiguracionLiquidacion.esquemaGeneralId` → NULL. Con NULL el motor calcula
// EXACTAMENTE lo que calculaba antes de S3-20 (coeficiente, renormalizado en
// B/C), así que un edificio sin nada configurado liquida igual que siempre: el
// default sale solo y los esquemas son la excepción que se agrega cuando el
// reglamento lo pide.
//
// Un esquema ad-hoc de UN gasto (el cargo por una rotura) no necesita modelo
// aparte: es un esquema del edificio con `alcance = SELECCION` que ningún gasto
// toma automáticamente, porque SELECCION no participa del matcheo — solo llega a
// un gasto que lo elige por `Gasto.esquemaRepartoId`. Un camino de código, no dos.
model EsquemaReparto {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  edificioId      String   @map("edificio_id") // el reglamento es de un edificio

  nombre          String   // "Ascensor (PB al 50%)", "Torre A", "Partes iguales"
  base            BaseReparto
  alcance         AlcanceReparto
  // El servicio ("ascensor") o el sector ("torre_a") del alcance. Obligatorio en
  // SERVICIO/SECTOR, NULL en TODAS/SELECCION (CHECK en la migración).
  alcanceValor    String?  @map("alcance_valor")

  // Trazabilidad legal (CCyC art. 2049): la cláusula que habilita este reparto.
  clausulaReglamento String? @map("clausula_reglamento")
  documentoUrl       String? @map("documento_url")

  // Baja lógica, igual que los rubros propios: un esquema ya usado en una
  // liquidación no se borra (el snapshot lo referencia), se desactiva.
  activo          Boolean  @default(true)

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])
  pesos           EsquemaRepartoUnidad[]
  gastos          Gasto[]
  liquidaciones   LiquidacionDetalle[]
  configuraciones ConfiguracionLiquidacion[]
  reglasFondoReserva ReglaFondoReserva[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // El nombre identifica al esquema en la UI y en el snapshot del recibo.
  @@unique([organizacionId, edificioId, nombre])
  // Determinismo del matcheo automático: un solo esquema ACTIVO por
  // servicio/sector de un edificio. Es un índice único PARCIAL, creado a mano en
  // la migración (Prisma no los soporta):
  //   CREATE UNIQUE INDEX esquemas_reparto_alcance_activo_unique
  //     ON esquemas_reparto (organizacion_id, edificio_id, alcance, alcance_valor)
  //     WHERE activo AND alcance IN ('SERVICIO', 'SECTOR');
  @@index([organizacionId, edificioId])
  @@index([organizacionId, edificioId, activo])
  @@map("esquemas_reparto")
}

// El peso de UNA UF en UN esquema. Solo existen las filas que hacen falta: la
// semántica de la fila ausente depende de la base (ver `EsquemaReparto`), así que
// un esquema "todas al 100% menos PB al 50%" es UNA fila, no N.
model EsquemaRepartoUnidad {
  organizacionId  String   @map("organizacion_id")
  esquemaId       String   @map("esquema_id")
  unidadId        String   @map("unidad_id")

  // 0 = exenta · 0.5 = mitad · o el coeficiente propio de la UF en la segunda
  // tabla del reglamento. Nunca negativo (CHECK en la migración).
  peso            Decimal  @db.Decimal(12, 6)

  esquema         EsquemaReparto @relation(fields: [esquemaId], references: [id], onDelete: Cascade)
  unidad          Unidad         @relation(fields: [unidadId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@id([esquemaId, unidadId])
  @@index([organizacionId, esquemaId])
  @@index([unidadId])
  @@map("esquema_reparto_unidades")
}

// El setup de liquidación del edificio. Hoy solo el esquema general (el default
// de los gastos de categoría A); S3-21 agrega acá el porcentaje de fondo de
// reserva, y S5 el día de vencimiento y el interés por mora. Una fila por
// edificio, creada on-demand: un edificio SIN fila liquida por coeficiente, que
// es exactamente el comportamiento previo a S3-20.
model ConfiguracionLiquidacion {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  edificioId      String   @unique @map("edificio_id")

  // Default de los gastos que no matchean ningún esquema por servicio/sector.
  // NULL = reparto por coeficiente sobre todas las UF (el default de siempre).
  esquemaGeneralId String? @map("esquema_general_id")

  edificio        Edificio        @relation(fields: [edificioId], references: [id], onDelete: Cascade)
  esquemaGeneral  EsquemaReparto? @relation(fields: [esquemaGeneralId], references: [id], onDelete: Restrict)

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizacionId])
  @@map("configuracion_liquidacion")
}

// NOTA RLS: `proveedores`, `rubros` y `rubro_visibilidad` son híbridas (ítems
// globales de plataforma con organizacion_id NULL + propios por org), así que
// no aplican la policy estándar de aislamiento por organización; la visibilidad
// se resuelve a nivel aplicación (merge maestro + propios, PRD-04-02 §1.3/§1.4).

// Base de cálculo del aporte al fondo de reserva (S3-21).
enum BaseFondoReserva {
  ORDINARIAS // % sobre el total de expensas ordinarias del período (el default)
  TOTAL      // % sobre ordinarias + extraordinarias
  MONTO_FIJO // importe fijo por período, sin porcentaje
}

// Qué representa una línea del detalle de la liquidación (S3-21).
enum TipoDetalleLiquidacion {
  GASTO
  FONDO_RESERVA
}

// Regla del fondo de reserva de un edificio, VIGENTE DESDE UN PERÍODO (S3-21).
//
// POR QUÉ VERSIONADA Y NO UN CAMPO EN `ConfiguracionLiquidacion`: el porcentaje
// lo fija una asamblea con fecha, y una liquidación emitida no puede cambiar de
// importe porque hoy alguien tocó la configuración. La liquidación de un período
// resuelve "la regla de mayor `vigenciaDesde` <= período" y guarda el snapshot
// de lo aplicado. Cambiar la regla afecta a los períodos siguientes, nunca al
// pasado — que es exactamente lo que pasa en el mundo real.
//
// El FONDO ES ACUMULATIVO más allá de la regla: cada liquidación aprobada suma
// su aporte, sin importar con qué regla se calculó.
model ReglaFondoReserva {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // "2026-08": el período DESDE el que rige (inclusive).
  vigenciaDesde   String   @map("vigencia_desde")

  base            BaseFondoReserva @default(ORDINARIAS)
  // % con dos decimales (5.00 = 5%) para ORDINARIAS/TOTAL; NULL en MONTO_FIJO.
  porcentaje      Decimal? @db.Decimal(5, 2)
  // Importe por período en MONTO_FIJO; NULL en las otras dos bases.
  montoFijo       Decimal? @map("monto_fijo") @db.Decimal(12, 2)

  // Con qué esquema se reparte el aporte entre las UFs. NULL = el esquema
  // general del edificio y, si no hay, el coeficiente. Existe porque contribuir
  // al fondo NO admite exención (CCyC art. 2046 inc. d): si el esquema general
  // del edificio exime a una UF de un servicio, esa exención no debería alcanzar
  // al fondo, y acá se le puede dar el suyo.
  esquemaRepartoId String? @map("esquema_reparto_id")

  // Respaldo de la decisión: "Asamblea del 12/07/2026". Es la brecha 3 del
  // research (respaldo documental) aplicada al caso más discutible.
  motivo          String?

  edificio        Edificio @relation(fields: [edificioId], references: [id], onDelete: Cascade)
  esquemaReparto  EsquemaReparto? @relation(fields: [esquemaRepartoId], references: [id], onDelete: Restrict)
  liquidaciones   Liquidacion[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  createdBy       String   @map("created_by")

  // Una sola regla por período de vigencia: dos reglas desde el mismo mes serían
  // ambiguas y el resolutor tendría que desempatar por un criterio inventado.
  @@unique([edificioId, vigenciaDesde])
  @@index([organizacionId, edificioId])
  @@map("reglas_fondo_reserva")
}

// ==========================================
// LIQUIDACIONES
// ==========================================

model Liquidacion {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Período
  periodo         String   // "2026-07"
  fechaLiquidacion DateTime @map("fecha_liquidacion")

  // Estado
  estado          EstadoLiquidacion @default(BORRADOR)

  // Totales
  totalOrdinarias Decimal  @map("total_ordinarias") @db.Decimal(12, 2)
  totalExtraordinarias Decimal @map("total_extraordinarias") @db.Decimal(12, 2)
  // Aporte al fondo de reserva del período (S3-21). Es el TERCER subtotal y no
  // se mezcla con los otros dos: la Ley 941 obliga a separar ordinarias de
  // extraordinarias, y el fondo no es ninguna de las dos (es una contribución
  // patrimonial, CCyC art. 2046 inc. d). `totalGeneral` los suma a los tres.
  totalFondoReserva Decimal @default(0) @map("total_fondo_reserva") @db.Decimal(12, 2)
  totalGeneral    Decimal  @map("total_general") @db.Decimal(12, 2)

  // SNAPSHOT de la regla del fondo aplicada (S3-21). Misma razón que
  // `esquemaNombre` y `cuotaNumero` en el detalle: cambiar el porcentaje a
  // futuro no puede reescribir lo que ya se emitió, y el recibo tiene que poder
  // explicar de dónde salió el número ("5,00% de las ordinarias").
  reglaFondoReservaId String? @map("regla_fondo_reserva_id")
  fondoReservaBase    BaseFondoReserva? @map("fondo_reserva_base")
  fondoReservaValor   Decimal? @map("fondo_reserva_valor") @db.Decimal(12, 2)

  // Ley 941
  matriculaRPA    String   @map("matricula_rpa")
  qrData          String?  @map("qr_data") // JSON con datos para QR

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])
  detalles        LiquidacionDetalle[]
  cobros          Cobro[]
  recibos         Recibo[]
  reglaFondoReserva ReglaFondoReserva? @relation(fields: [reglaFondoReservaId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  approvedBy      String?  @map("approved_by")
  approvedAt      DateTime? @map("approved_at")

  // Unicidad de período por edificio: índice único PARCIAL SQL creado a mano
  // en la migración (Prisma no soporta índices parciales), excluyendo ANULADA
  // para permitir anular → regenerar el mismo período (PRD-04-02 §6):
  //   CREATE UNIQUE INDEX liquidaciones_periodo_activo_unique
  //     ON liquidaciones (organizacion_id, edificio_id, periodo)
  //     WHERE estado != 'ANULADA';
  @@index([organizacionId, edificioId])
  @@index([organizacionId, edificioId, estado])
  @@map("liquidaciones")
}

model LiquidacionDetalle {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  liquidacionId   String   @map("liquidacion_id")
  unidadId        String   @map("unidad_id")

  // Qué representa esta línea (S3-21). `GASTO` es el default histórico: la parte
  // de un gasto que le toca a una UF. `FONDO_RESERVA` es el aporte del período,
  // que no tiene gasto detrás — de ahí que `gastoId` sea opcional. Modelarlo como
  // un detalle más y no en una tabla aparte mantiene UNA sola definición de
  // "lo que paga esta UF": el reparto, la fila del recibo y la reconciliación
  // (Σ detalles = total de la liquidación) siguen siendo las mismas.
  tipo            TipoDetalleLiquidacion @default(GASTO)
  gastoId         String?  @map("gasto_id")

  // Cuota del plan que este detalle imputa (S3-19). NULL = gasto de imputación
  // única (el caso por default). `cuotaNumero`/`cuotasTotal` son el SNAPSHOT del
  // rótulo "cuota k/N" al momento de liquidar, no una vista de `GastoCuota`:
  // un recibo emitido no puede pasar de "3/6" a "3/8" porque después se editó
  // el plan (misma regla que `coeficienteAplicado`).
  gastoCuotaId    String?  @map("gasto_cuota_id")
  cuotaNumero     Int?     @map("cuota_numero")
  cuotasTotal     Int?     @map("cuotas_total")

  // Esquema de reparto que produjo este peso (S3-20). NULL = reparto por
  // coeficiente según la categoría, el default. `esquemaNombre` es el SNAPSHOT
  // del nombre al momento de liquidar, no una vista de `EsquemaReparto`: la
  // inmutabilidad del recibo emitido es la única defensa contra un cambio de
  // reglamento o de titularidad posterior. Renombrar o desactivar un esquema NO
  // puede reescribir un recibo, igual que `coeficienteAplicado` y `cuotaNumero`.
  esquemaRepartoId String? @map("esquema_reparto_id")
  esquemaNombre    String? @map("esquema_nombre")

  // Distribución
  coeficienteAplicado Decimal @map("coeficiente_aplicado") @db.Decimal(10, 6)
  montoAsignado   Decimal  @db.Decimal(12, 2)

  // Relaciones
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id])
  unidad          Unidad   @relation(fields: [unidadId], references: [id])
  // Restrict explícito: al ser opcional, Prisma asumiría `SetNull` y un gasto
  // borrado dejaría detalles liquidados sin decir de qué eran. El soft delete
  // del gasto (Ley 941) ya cubre la baja.
  gasto           Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Restrict)
  gastoCuota      GastoCuota? @relation(fields: [gastoCuotaId], references: [id], onDelete: Restrict)
  esquemaReparto  EsquemaReparto? @relation(fields: [esquemaRepartoId], references: [id], onDelete: Restrict)

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")

  // El aporte al fondo entra una vez por UF y por liquidación, y no tiene
  // `gastoId` que lo distinga: el índice único parcial que lo garantiza se crea
  // a mano en la migración (Prisma no expresa índices parciales):
  //   CREATE UNIQUE INDEX liquidacion_detalles_fondo_unique
  //     ON liquidacion_detalles (liquidacion_id, unidad_id) WHERE gasto_id IS NULL;
  @@unique([organizacionId, liquidacionId, unidadId, gastoId])
  @@index([organizacionId, liquidacionId])
  @@index([organizacionId, unidadId])
  @@index([gastoCuotaId])
  @@index([esquemaRepartoId])
  @@map("liquidacion_detalles")
}

// ==========================================
// RECIBOS (Ley 941)
// ==========================================

// Recibo de expensas emitido: un PDF por UF de una liquidación ENVIADA (S3-05,
// PRD-02-05 §4, PRD-06-01 §3). La fila es el COMPROBANTE EMITIDO, no una vista
// de la liquidación: copia los datos que la Ley 941 exige mostrar (matrícula
// RPA, período, totales ord/ext, fecha de emisión, payload del QR) para que el
// recibo siga siendo el que se emitió aunque la organización cambie de
// administrador responsable después. El PDF no vive en la DB: `storageDriver` +
// `storageKey` lo localizan (ver src/services/almacenamiento.js).
model Recibo {
  id              String   @id @default(uuid())
  organizacionId  String   @map("organizacion_id")
  liquidacionId   String   @map("liquidacion_id")
  unidadId        String   @map("unidad_id")

  // Numeración correlativa por liquidación ("2026-07-0001"), Ley 941 §3.1
  numero          String

  // Copia de los datos legales al momento de emitir
  periodo         String
  matriculaRPA    String   @map("matricula_rpa")
  totalOrdinarias Decimal  @map("total_ordinarias") @db.Decimal(12, 2)
  totalExtraordinarias Decimal @map("total_extraordinarias") @db.Decimal(12, 2)
  // Lo que esta UF aporta al fondo de reserva en el período (S3-21). El recibo
  // lo imprime como tercer subtotal, separado de ordinarias y extraordinarias;
  // el snapshot de CON QUÉ REGLA se calculó vive en la liquidación.
  totalFondoReserva Decimal @default(0) @map("total_fondo_reserva") @db.Decimal(12, 2)
  totalGeneral    Decimal  @map("total_general") @db.Decimal(12, 2)
  qrData          String   @map("qr_data") // JSON embebido en el QR del PDF
  fechaEmision    DateTime @map("fecha_emision")

  // Archivo: "filesystem" (default) o "minio" cuando exista el driver
  storageDriver   String   @default("filesystem") @map("storage_driver")
  storageKey      String   @map("storage_key")
  bytes           Int
  sha256          String

  // Relaciones
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id])
  unidad          Unidad      @relation(fields: [unidadId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Un recibo por UF y liquidación: hace idempotente cualquier reintento de
  // generación y sostiene el 409 de `enviar` (la transición ya es el candado).
  @@unique([organizacionId, liquidacionId, unidadId])
  @@unique([organizacionId, liquidacionId, numero])
  @@index([organizacionId, liquidacionId])
  @@index([organizacionId, unidadId])
  @@map("recibos")
}

// ==========================================
// COBROS
// ==========================================

model Cobro {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  liquidacionId   String   @map("liquidacion_id")
  unidadId        String   @map("unidad_id")

  // Montos
  montoTotal      Decimal  @map("monto_total") @db.Decimal(12, 2)
  montoPagado     Decimal  @default(0) @map("monto_pagado") @db.Decimal(12, 2)
  montoPendiente  Decimal  @map("monto_pendiente") @db.Decimal(12, 2)

  // Estado
  estado          EstadoCobro @default(PENDIENTE)

  // Pago
  metodoPago      String?  @map("metodo_pago") // "mercadopago", "transferencia", "efectivo"
  referenciaPago  String?  @map("referencia_pago")
  fechaPago       DateTime? @map("fecha_pago")

  // Relaciones
  liquidacion     Liquidacion @relation(fields: [liquidacionId], references: [id])
  unidad          Unidad   @relation(fields: [unidadId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([organizacionId, unidadId])
  @@index([organizacionId, estado])
  @@index([organizacionId, liquidacionId])
  @@map("cobros")
}

// ==========================================
// TICKETS / KANBAN
// ==========================================

model Ticket {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Datos
  titulo          String
  descripcion     String
  estado          EstadoTicket @default(NUEVO)
  prioridad       PrioridadTicket @default(MEDIA)

  // Categorización IA
  categoriaIA     String?  @map("categoria_ia") // Clasificación automática
  confianzaIA     Decimal? @map("confianza_ia") @db.Decimal(3, 2) // 0.00 - 1.00

  // Asignación
  creadorId       String   @map("creador_id")
  asignadoId      String?  @map("asignado_id")

  // Origen
  fuente          String   @default("manual") // "email", "whatsapp", "portal", "manual"
  referenciaExterna String? @map("referencia_externa") // ID de email, etc.

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])
  creador         Usuario  @relation("TicketCreador", fields: [creadorId], references: [id])
  asignado        Usuario? @relation("TicketAsignado", fields: [asignadoId], references: [id])
  comentarios     TicketComentario[]

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  resueltoAt      DateTime? @map("resuelto_at")

  @@index([organizacionId, edificioId])
  @@index([organizacionId, estado])
  @@index([organizacionId, prioridad])
  @@index([organizacionId, creadorId])
  @@map("tickets")
}

model TicketComentario {
  id          String   @id @default(uuid())
  organizacionId    String   @map("organizacion_id")
  ticketId    String   @map("ticket_id")

  contenido   String
  esInterno   Boolean  @default(false) @map("es_interno") // true = solo admin

  // Relaciones
  ticket      Ticket   @relation(fields: [ticketId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")

  @@index([organizacionId, ticketId])
  @@map("ticket_comentarios")
}

// ==========================================
// COMUNICACIONES
// ==========================================

model Comunicacion {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Datos
  tipo            TipoComunicacion
  asunto          String
  contenido       String
  contenidoHtml   String?  @map("contenido_html")

  // Destinatarios
  destinatarios   String[] // Array de emails

  // Estado
  enviado         Boolean  @default(false)
  fechaEnvio      DateTime? @map("fecha_envio")

  // Métricas
  abiertos        Int      @default(0)
  clicks          Int      @default(0)

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String   @map("created_by")

  @@index([organizacionId, edificioId])
  @@index([organizacionId, tipo])
  @@map("comunicaciones")
}

// ==========================================
// DOCUMENTOS
// ==========================================

model Documento {
  id              String   @id @default(uuid())
  organizacionId        String   @map("organizacion_id")
  edificioId      String   @map("edificio_id")

  // Datos
  tipo            TipoDocumento
  nombre          String
  url             String
  mimeType        String   @map("mime_type")
  tamaño          Int      // Bytes

  // OCR / IA
  textoExtraido   String?  @map("texto_extraido")
  embedding       Unsupported("vector(768)")? // pgvector

  // Relaciones
  edificio        Edificio @relation(fields: [edificioId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  uploadedBy      String   @map("uploaded_by")

  @@index([organizacionId, edificioId])
  @@index([organizacionId, tipo])
  @@map("documentos")
}

// ==========================================
// AUDITORÍA
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  organizacionId    String   @map("organizacion_id")

  // Qué pasó
  tabla       String
  registroId  String   @map("registro_id")
  accion      String   // "CREATE", "UPDATE", "DELETE"

  // Datos
  datosAnteriores Json?  @map("datos_anteriores")
  datosNuevos   Json?    @map("datos_nuevos")
  diff          Json?    // Solo los campos cambiados

  // Quién
  usuarioId   String   @map("usuario_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")

  // Relaciones
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  // Timestamp
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([organizacionId, tabla])
  @@index([organizacionId, registroId])
  @@index([organizacionId, usuarioId])
  @@index([organizacionId, createdAt])
  @@map("audit_logs")
}

// ==========================================
// CONFIGURACIÓN POR ORGANIZACIÓN
// ==========================================

model OrganizacionConfig {
  id              String   @id @default(uuid())
  organizacionId  String   @unique @map("organizacion_id")

  // Configuración general
  nombrePlataforma String  @map("nombre_plataforma")
  dominioEmail    String   @map("dominio_email") // Dominio base de la organización (consorcios.miestudio.com); los inboxes se generan por edificio (edificio-123@consorcios.miestudio.com)

  // Feature flags
  enableSwarm     Boolean  @default(true) @map("enable_swarm")
  enableOCR       Boolean  @default(true) @map("enable_ocr")
  enableKanban    Boolean  @default(false) @map("enable_kanban")
  enableBenchmarking Boolean @default(false) @map("enable_benchmarking")

  // MercadoPago (credenciales de la organización)
  mpAccessToken   String?  @map("mp_access_token")
  mpPublicKey     String?  @map("mp_public_key")

  // WhatsApp (credenciales de la organización)
  waBusinessId    String?  @map("wa_business_id")
  waPhoneNumberId String?  @map("wa_phone_number_id")

  // Relaciones
  organizacion    Organizacion @relation(fields: [organizacionId], references: [id])

  // Timestamps
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("organizacion_configs")
}
